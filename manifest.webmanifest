{
 "name": "Kreuzberg Ästhetik Praxismanagement",
 "short_name": "Praxis",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "background_color": "#ffffff",
 "theme_color": "#ffffff",
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": { "files": [ { "name": "bilder", "accept": ["image/*"] } ] }
 },
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}